# OMFIT-SEO Environment Variables Configuration
# Copy this file to '.env' and fill in your private API keys.
# NEVER commit '.env' to public Git repositories!

# Frontend key used by the existing article-generation flow.
# For production, migrate this flow to the backend as well.
VITE_GEMINI_API_KEY=

# OpenAI API Key (For DALL-E 3 Image Generation)
VITE_OPENAI_API_KEY=

# Google Vertex AI API Key (Optional fallback for Imagen 3)
VITE_VERTEX_API_KEY=

# Leonardo AI API Key (For Image Generation)
VITE_LEONARDO_API_KEY=

# Target WordPress Site URL
VITE_WP_SITE_URL=https://omfit.com.vn

# Backend-only Gemini key for SEO enrichment. Never prefix backend secrets with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Google Ads Keyword Planner (backend only)
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
# Optional when authenticating through a Google Ads manager account
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v25
# Vietnamese language and Vietnam location
GOOGLE_ADS_LANGUAGE_ID=1040
GOOGLE_ADS_GEO_TARGET_ID=2704
KEYWORD_SEED_URL=https://omfit.com.vn
# Cache keyword responses for 6 hours to protect Keyword Planner quota
KEYWORD_CACHE_TTL_MS=21600000
API_PORT=8787
