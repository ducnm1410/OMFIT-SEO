# OMFIT-SEO Environment Variables Configuration
# Copy this file to '.env' and fill in your private API keys.
# NEVER commit '.env' to public Git repositories!

# Google Gemini API Key (For SEO Content Generation & Keyword Trend Analysis)
VITE_GEMINI_API_KEY=

# OpenAI API Key (For DALL-E 3 Image Generation)
VITE_OPENAI_API_KEY=

# Google Vertex AI API Key (Optional fallback for Imagen 3)
VITE_VERTEX_API_KEY=

# Leonardo AI API Key (For Image Generation)
VITE_LEONARDO_API_KEY=

# Target WordPress Site URL
VITE_WP_SITE_URL=https://omfit.com.vn
