# OMFIT-SEO Environment Variables Configuration
# Copy this file to '.env' and fill in your private API keys.
# NEVER commit '.env' to public Git repositories!

# Public frontend configuration only
VITE_WP_SITE_URL=https://omfit.com.vn

# Supabase Auth public configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend-only credentials. Never prefix secrets with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional but recommended: random 32-byte secret used only to sign video job tickets.
# Generate once with: openssl rand -hex 32
VIDEO_EDITOR_JOB_SECRET=
# Railway enables the 14-day image/video cleanup worker by default in production.
# Set false only when another dedicated cleanup worker is running.
MEDIA_RETENTION_ENABLED=true
# Optional model override for Google Search Grounding research.
GEMINI_RESEARCH_MODEL=gemini-2.5-flash
LEONARDO_API_KEY=
WP_SITE_URL=https://omfit.com.vn
WP_USERNAME=
WP_APP_PASSWORD=

# Google Search Console (backend only)
# Create a Google Cloud service account, enable Search Console API, then add
# its client email as a Full user on the matching Search Console property.
GOOGLE_SEARCH_CONSOLE_CLIENT_EMAIL=
# Keep this quoted on hosting providers and preserve newlines as \\n.
GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY=
GOOGLE_SEARCH_CONSOLE_PROPERTY=sc-domain:omfit.com.vn
GOOGLE_SEARCH_CONSOLE_SITEMAP_URL=https://omfit.com.vn/wp-sitemap.xml

# Google Ads Keyword Planner (backend only)
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
# Optional fallback for server-to-server use. Normal users connect from the UI.
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
# Optional when authenticating through a Google Ads manager account
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Random secret with at least 32 bytes, used to encrypt the HttpOnly OAuth session cookie
OAUTH_SESSION_SECRET=
# Must exactly match the origin configured in Google Cloud OAuth redirect URIs
OAUTH_REDIRECT_BASE=http://localhost:5173
GOOGLE_ADS_API_VERSION=v25
# Vietnamese language and Vietnam location
GOOGLE_ADS_LANGUAGE_ID=1040
GOOGLE_ADS_GEO_TARGET_ID=2704
KEYWORD_SEED_URL=https://omfit.com.vn
# Cache keyword responses for 6 hours to protect Keyword Planner quota
KEYWORD_CACHE_TTL_MS=21600000
API_PORT=8787
