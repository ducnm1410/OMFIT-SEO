{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/research/sources",
      "destination": "/api/content/article?__omfit_route=research-sources"
    },
    {
      "source": "/api/media/register",
      "destination": "/api/content/article?__omfit_route=media-register"
    },
    {
      "source": "/api/wordpress/post-publish-seo",
      "destination": "/api/wordpress/sync-index?__omfit_route=post-publish-seo"
    }
  ],
  "functions": {
    "api/health.mjs": {
      "maxDuration": 15
    },
    "api/auth/google/start.mjs": {
      "maxDuration": 15
    },
    "api/auth/google/callback.mjs": {
      "maxDuration": 30
    },
    "api/auth/google/status.mjs": {
      "maxDuration": 30
    },
    "api/auth/google/select-account.mjs": {
      "maxDuration": 30
    },
    "api/auth/google/disconnect.mjs": {
      "maxDuration": 15
    },
    "api/keywords/analyze.mjs": {
      "maxDuration": 60
    },
    "api/content/outline.mjs": {
      "maxDuration": 60
    },
    "api/content/article.mjs": {
      "maxDuration": 60
    },
    "api/images/generate.mjs": {
      "maxDuration": 60
    },
    "api/wordpress/publish.mjs": {
      "maxDuration": 60
    },
    "api/wordpress/sync-index.mjs": {
      "maxDuration": 60
    }
  }
}
